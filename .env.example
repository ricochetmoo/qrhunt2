DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional: absolute origin used by server-side apiClient calls (defaults to BETTER_AUTH_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local player bootstrap. Run `pnpm db:seed` first and use its printed game code.
NEXT_PUBLIC_PLAYER_GAME_CODE=
# Development-only API identity; use a seeded player such as foxes-dex@seed.local.
MOCK_PLAYER_EMAIL=foxes-dex@seed.local
